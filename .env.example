# Copy this file to ".env" and fill in ONE of the two keys.
# Never commit .env to Git.

# Option 1 (recommended, free): Google Gemini  -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2 (free): Groq  -> https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Which provider to use: google or groq (auto-picks google if a Gemini key is set)
MODEL_PROVIDER=google

HOST=127.0.0.1
PORT=8000
REQUEST_TIMEOUT=90
